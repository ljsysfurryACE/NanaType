{
  "name": "nanatype-promo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-skins.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Promo out/nanatype-promo.mp4 --crf=16",
    "cover": "remotion still src/index.ts BilibiliCover out/nanatype-bilibili-cover.png",
    "cover:16x9": "remotion still src/index.ts BilibiliCover16x9 out/nanatype-bilibili-cover-16x9.png",
    "cover:mobile": "remotion still src/index.ts BilibiliCover out/nanatype-bilibili-cover-mobile.png --scale=0.2",
    "cover:4x3": "remotion still src/index.ts BilibiliCover4x3 out/nanatype-bilibili-cover-4x3.png",
    "cover:mobile:4x3": "remotion still src/index.ts BilibiliCover4x3 out/nanatype-bilibili-cover-mobile-4x3.png --scale=0.2",
    "cover:douyin": "remotion still src/index.ts DouyinCover out/nanatype-douyin-cover.png",
    "cover:douyin:mobile": "remotion still src/index.ts DouyinCover out/nanatype-douyin-cover-mobile.png --scale=0.3",
    "capture:chat": "cd .. && cargo run -p nanatype --example chat_parity -- promo/public/chat-parity nanatype.halo zh-CN capture",
    "render:chat": "remotion render src/index.ts ChatParity out/chat-parity.mp4 --crf=16"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/gif": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "smol-toml": "1.9.1",
    "typescript": "7.0.2"
  }
}
